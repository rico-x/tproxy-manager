{
  // Роль: входящие подключения. Соответствует xray 02_inbounds.json:
  // socks на 10808 и TPROXY на 61219. У sing-box один tproxy-вход обслуживает
  // и tcp, и udp, поэтому вместо двух xray-входов здесь один.
  "inbounds": [
    {
      "type": "mixed",
      "tag": "socks",
      "listen": "127.0.0.1",
      "listen_port": 10808,
      "sniff": true,
      "sniff_override_destination": true
    },
    {
      "type": "tproxy",
      "tag": "tproxy-in",
      "listen": "::",
      "listen_port": 61219,
      "sniff": true,
      "sniff_override_destination": true
    }
  ]
}
