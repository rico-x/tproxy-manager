{
  // Роль 04 — управляемое подключение. ЭТОТ ФАЙЛ ПЕРЕЗАПИСЫВАЕТ ПАКЕТ.
  //
  // Показано, что получается после применения ссылки: тег `proxy` — применённая
  // ссылка, `direct` — прямой выход для правил роли 05. Блокировка у sing-box
  // делается действием правила (`"action": "reject"`), а не отдельным outbound:
  // устаревший `block` удалён из современных версий.
  //
  // Править вручную бесполезно: следующее применение ссылки заменит файл целиком.
  "outbounds": [
    {
      "type": "vless",
      "tag": "proxy",
      "server": "192.0.2.20",
      "server_port": 443,
      "uuid": "00000000-0000-0000-0000-000000000000",
      "tls": { "enabled": true, "server_name": "example.com" }
    },
    { "type": "direct", "tag": "direct" }
  ]
}
