{
  // Роль 03 — ваши собственные подключения. Пакет этот файл НЕ ПИШЕТ никогда.
  //
  // Сюда добавляются прокси, которые вы держите сами: отдельный сервер для
  // конкретных доменов, резервный канал, прокси другого провайдера. Ссылаться на
  // них из правил маршрутизации (роль 05) можно по тегу.
  //
  // Xray склеивает массивы из всех файлов каталога, поэтому эти outbound
  // добавляются к управляемому, а не заменяют его.
  "outbounds": [
    {
      "tag": "proxy-ru",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "192.0.2.10",
            "port": 443,
            "users": [
              { "id": "00000000-0000-0000-0000-000000000000", "flow": "xtls-rprx-vision", "encryption": "none" }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "serverName": "example.com",
          "fingerprint": "chrome",
          // Ключ ниже — одноразовый пример, замените своим.
          "publicKey": "gkxLlrezdTjW03joL4PVcYM2GSNLrafqUiyyYTPmszU",
          "shortId": "0123456789abcdef",
          "spiderX": "/"
        }
      }
    }
  ]
}
