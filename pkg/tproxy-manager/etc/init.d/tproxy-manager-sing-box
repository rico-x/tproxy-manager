#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=15

CONFIG_DIR="/etc/sing-box/tproxy-manager.d"
CONFIG_FILE="/etc/sing-box/tproxy-manager.json"
BIN="/usr/bin/sing-box"

start_service() {
  [ -x "$BIN" ] || return 1
  config_load tproxy-manager
  config_get CONFIG_DIR main singbox_profile_config_dir "/etc/sing-box/tproxy-manager.d"
  config_get CONFIG_FILE main singbox_profile_config_file "/etc/sing-box/tproxy-manager.json"
  procd_open_instance
  # Каталог фрагментов по ролям, если он есть: sing-box сливает их сам, включая
  # массивы, поэтому пользовательские outbound живут в своём файле и не зависят
  # от перезаписи управляемого. Одиночный файл остаётся запасом для установок,
  # которые ещё не переведены на каталог.
  if [ -x /usr/libexec/tproxy-manager/assemble-config ] \
    && /usr/libexec/tproxy-manager/assemble-config singbox --check >/dev/null 2>&1; then
    procd_set_param command "$BIN" run -C "$CONFIG_DIR"
  else
    [ -f "$CONFIG_FILE" ] || return 1
    procd_set_param command "$BIN" run -c "$CONFIG_FILE"
  fi
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param respawn 3600 5 5
  procd_close_instance
}

reload_service() {
  restart
}
