if [ ! -s /etc/mihomo/tproxy-manager.yaml ]; then
  cat > /etc/mihomo/tproxy-manager.yaml <<'EOF'
allow-lan: false
bind-address: 127.0.0.1
mode: rule
log-level: warning
ipv6: true
mixed-port: 10808
tproxy-port: 61219
proxy-groups:
  - name: TPROXY-MANAGER
    type: select
    proxies:
      - DIRECT
rules:
  - MATCH,DIRECT
EOF
fi

# Migration: older versions wrote "mode: global" into the Mihomo config. In that
# mode Mihomo ignores `rules` completely and routes everything through its
# built-in GLOBAL selector, whose default is DIRECT - so the MATCH rule below was
# dead and traffic bypassed the proxy entirely. The block above only writes the
# file when it is missing, so an upgrade would leave existing installs broken.
#
# Only files this package generated are touched, identified by their own
# signature: a managed runtime config carries "MATCH,TPROXY-MANAGER", the
# bootstrap placeholder carries the TPROXY-MANAGER group together with
# "MATCH,DIRECT". A hand-written profile matches neither and is left alone.
# The path is an argument so the regression suite can drive this against its own
# fixtures instead of the live config.
migrate_mihomo_mode() {
	cfg="${1:-/etc/mihomo/tproxy-manager.yaml}"
	[ -s "$cfg" ] || return 0
	grep -q '^mode:[[:space:]]*global[[:space:]]*$' "$cfg" || return 0

	if grep -q 'MATCH,TPROXY-MANAGER' "$cfg" ||
		{ grep -q 'name:[[:space:]]*TPROXY-MANAGER' "$cfg" && grep -q 'MATCH,DIRECT' "$cfg"; }; then
		cp "$cfg" "$cfg.bak.$(date +%Y%m%d-%H%M%S)" 2>/dev/null
		# Anchored and end-anchored: only the top-level key, never a nested one.
		sed -i 's|^mode:[[:space:]]*global[[:space:]]*$|mode: rule|' "$cfg"
		if grep -q '^mode:[[:space:]]*rule[[:space:]]*$' "$cfg"; then
			logger -t tproxy-manager "mihomo config migrated: mode global -> rule ($cfg)"
		else
			logger -t tproxy-manager "mihomo config migration FAILED, left as is ($cfg)"
		fi
	else
		logger -t tproxy-manager "mihomo config not generated by this package, mode left as is ($cfg)"
	fi
}
migrate_mihomo_mode

if [ ! -s /etc/mihomo/tproxy-manager-proxies.yaml ]; then
