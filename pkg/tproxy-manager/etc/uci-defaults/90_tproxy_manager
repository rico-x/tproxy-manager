#!/bin/sh
# Idempotent defaults for OpenWrt UCI

set -e

# --- /etc/tproxy-manager: каталог и пустые файлы только если их нет ---
mkdir -p /etc/tproxy-manager
mkdir -p /usr/share/tproxy-manager
mkdir -p /etc/mihomo
mkdir -p /etc/sing-box
for f in \
  /etc/tproxy-manager/tproxy-manager.ports \
  /etc/tproxy-manager/tproxy-manager.v4 \
  /etc/tproxy-manager/tproxy-manager.v6 \
  /etc/tproxy-manager/tproxy-manager.src4.only \
  /etc/tproxy-manager/tproxy-manager.src6.only \
  /etc/tproxy-manager/tproxy-manager.src4.bypass \
  /etc/tproxy-manager/tproxy-manager.src6.bypass \
  /etc/tproxy-manager/watchdog.links
do
  [ -e "$f" ] || : > "$f"
done

if [ ! -s /etc/tproxy-manager/watchdog-subscriptions.json ]; then
  cat > /etc/tproxy-manager/watchdog-subscriptions.json <<'EOF'
{
  "version": 1,
  "next_id": 1,
  "subscriptions": [],
  "links": {},
  "excluded": {}
}
EOF
fi

if [ ! -s /etc/tproxy-manager/watchdog-share.json ]; then
  cat > /etc/tproxy-manager/watchdog-share.json <<'EOF'
{
  "version": 1,
  "selection_mode": "all",
  "selected": {}
}
EOF
fi

if [ ! -s /etc/tproxy-manager/geo-sources.conf ]; then
  cat > /etc/tproxy-manager/geo-sources.conf <<'EOF'
[
  {
    "dest": "/usr/share/tproxy-manager/geoip.dat",
    "url": "https://github.com/Loyalsoldier/geoip/releases/latest/download/geoip.dat",
    "name": "GeoIP"
  },
  {
    "dest": "/usr/share/tproxy-manager/geosite.dat",
    "url": "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat",
    "name": "GeoSite"
  }
]
EOF
fi

if [ ! -s /etc/mihomo/tproxy-manager.yaml ]; then
  cat > /etc/mihomo/tproxy-manager.yaml <<'EOF'
allow-lan: false
bind-address: 127.0.0.1
mode: global
log-level: warning
ipv6: true
mixed-port: 10808
tproxy-port: 61219
proxy-groups:
  - name: TPROXY-MANAGER
    type: select
    proxies:
      - DIRECT
rules:
  - MATCH,DIRECT
EOF
fi

if [ ! -s /etc/mihomo/tproxy-manager-proxies.yaml ]; then
  cat > /etc/mihomo/tproxy-manager-proxies.yaml <<'EOF'
proxies: []
EOF
fi

if [ ! -s /etc/sing-box/tproxy-manager.json ]; then
  cat > /etc/sing-box/tproxy-manager.json <<'EOF'
{
  "log": {
    "level": "warn"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 10808
    },
    {
      "type": "tproxy",
      "tag": "tproxy-in",
      "listen": "::",
      "listen_port": 61219
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "final": "direct"
  }
}
EOF
fi

if [ ! -s /etc/sing-box/tproxy-manager-outbounds.json ]; then
  cat > /etc/sing-box/tproxy-manager-outbounds.json <<'EOF'
[
  {
    "type": "direct",
    "tag": "direct"
  }
]
EOF
fi

if [ ! -e /etc/tproxy-manager/watchdog-outbound.template.jsonc ] && [ -f /usr/share/tproxy-manager/watchdog-outbound.template.jsonc ]; then
