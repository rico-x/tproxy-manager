#!/bin/sh
# Idempotent defaults for OpenWrt UCI

set -e

# --- /etc/tproxy-manager: каталог и пустые файлы только если их нет ---
mkdir -p /etc/tproxy-manager
mkdir -p /usr/share/tproxy-manager
mkdir -p /etc/mihomo
mkdir -p /etc/sing-box

# A new install starts on the role-fragment layout. An upgrade that already has
# a monolithic profile stays on that exact profile: deciding that a config is
# "ours" from a couple of tags is not strong enough evidence to replace its
# listener ports, routing or active outbound with package defaults. The init
# scripts and Watchdog deliberately retain their legacy path while the target
# directory is absent, so compatibility does not cost any outbound-template
# functionality.
#
# This runs BEFORE the bootstrap monoliths below are created; after that point a
# fresh install and an upgrade would be indistinguishable.
seed_profile_dir_if_no_legacy() {
  _legacy="$1"
  _engine="$2"
  _target="$3"
  _source="${4:-/usr/share/tproxy-manager/config-defaults/$_engine}"
  { [ ! -e "$_legacy" ] && [ ! -L "$_legacy" ]; } || return 0
  [ ! -e "$_target" ] || return 0
  [ -d "$_source" ] || return 0
  _tmp="${_target}.tmp.$$"
  rm -rf "$_tmp"
  mkdir -p "$_tmp" || return 1
  cp -p "$_source"/* "$_tmp"/ || { rm -rf "$_tmp"; return 1; }
  mv "$_tmp" "$_target" || { rm -rf "$_tmp"; return 1; }
}

seed_profile_dir_if_no_legacy \
  /etc/mihomo/tproxy-manager.yaml mihomo /etc/mihomo/tproxy-manager.d
seed_profile_dir_if_no_legacy \
  /etc/sing-box/tproxy-manager.json sing-box /etc/sing-box/tproxy-manager.d

for f in \
  /etc/tproxy-manager/tproxy-manager.ports \
  /etc/tproxy-manager/tproxy-manager.v4 \
  /etc/tproxy-manager/tproxy-manager.v6 \
  /etc/tproxy-manager/tproxy-manager.src4.only \
  /etc/tproxy-manager/tproxy-manager.src6.only \
  /etc/tproxy-manager/tproxy-manager.src4.bypass \
  /etc/tproxy-manager/tproxy-manager.src6.bypass \
  /etc/tproxy-manager/watchdog.links
do
  [ -e "$f" ] || : > "$f"
done

