fi

if [ ! -e /etc/tproxy-manager/watchdog-batch-test-config.template.jsonc ] && [ -f /usr/share/tproxy-manager/watchdog-batch-test-config.template.jsonc ]; then
  cp /usr/share/tproxy-manager/watchdog-batch-test-config.template.jsonc /etc/tproxy-manager/watchdog-batch-test-config.template.jsonc
fi

if [ ! -e /etc/tproxy-manager/watchdog-hysteria-outbound.template.jsonc ] && [ -f /usr/share/tproxy-manager/watchdog-hysteria-outbound.template.jsonc ]; then
  cp /usr/share/tproxy-manager/watchdog-hysteria-outbound.template.jsonc /etc/tproxy-manager/watchdog-hysteria-outbound.template.jsonc
fi

if [ ! -e /etc/tproxy-manager/watchdog-hysteria-test-config.template.jsonc ] && [ -f /usr/share/tproxy-manager/watchdog-hysteria-test-config.template.jsonc ]; then
  cp /usr/share/tproxy-manager/watchdog-hysteria-test-config.template.jsonc /etc/tproxy-manager/watchdog-hysteria-test-config.template.jsonc
fi

if [ ! -e /etc/tproxy-manager/watchdog-hysteria-batch-test-config.template.jsonc ] && [ -f /usr/share/tproxy-manager/watchdog-hysteria-batch-test-config.template.jsonc ]; then
  cp /usr/share/tproxy-manager/watchdog-hysteria-batch-test-config.template.jsonc /etc/tproxy-manager/watchdog-hysteria-batch-test-config.template.jsonc
fi

if [ ! -e /etc/tproxy-manager/watchdog-mihomo-test-config.template.yaml ] && [ -f /usr/share/tproxy-manager/watchdog-mihomo-test-config.template.yaml ]; then
  cp /usr/share/tproxy-manager/watchdog-mihomo-test-config.template.yaml /etc/tproxy-manager/watchdog-mihomo-test-config.template.yaml
fi

if [ ! -e /etc/tproxy-manager/watchdog-mihomo-batch-test-config.template.yaml ] && [ -f /usr/share/tproxy-manager/watchdog-mihomo-batch-test-config.template.yaml ]; then
  cp /usr/share/tproxy-manager/watchdog-mihomo-batch-test-config.template.yaml /etc/tproxy-manager/watchdog-mihomo-batch-test-config.template.yaml
fi

if [ ! -e /etc/tproxy-manager/watchdog-singbox-test-config.template.jsonc ] && [ -f /usr/share/tproxy-manager/watchdog-singbox-test-config.template.jsonc ]; then
  cp /usr/share/tproxy-manager/watchdog-singbox-test-config.template.jsonc /etc/tproxy-manager/watchdog-singbox-test-config.template.jsonc
fi

if [ ! -e /etc/tproxy-manager/watchdog-singbox-batch-test-config.template.jsonc ] && [ -f /usr/share/tproxy-manager/watchdog-singbox-batch-test-config.template.jsonc ]; then
  cp /usr/share/tproxy-manager/watchdog-singbox-batch-test-config.template.jsonc /etc/tproxy-manager/watchdog-singbox-batch-test-config.template.jsonc
fi

# --- UCI доступен? ---
command -v uci >/dev/null 2>&1 || exit 0

# На случай полностью отсутствующего файла конфига (безопасно):
[ -f /etc/config/tproxy-manager ] || touch /etc/config/tproxy-manager

# --- UCI helpers ---
# set_default <cfg> <section> <option> <value>
set_default() {
  local cfg="$1" sec="$2" opt="$3" val="$4"
  if ! uci -q get "$cfg.$sec.$opt" >/dev/null 2>&1; then
    uci set "$cfg.$sec.$opt=$val"
  fi
}

# ensure_section <cfg> <section_name> <type>
ensure_section() {
  local cfg="$1" sec="$2" typ="$3"
  # Универсально: создаёт пакет и именованную секцию при отсутствии
  uci set "$cfg.$sec=$typ"
}

# --- tproxy-manager (наш UCI) ---
ensure_section tproxy-manager main main
set_default tproxy-manager main proxy_engine       'xray'
set_default tproxy-manager main log_enabled        '1'
