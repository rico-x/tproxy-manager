{
  // Base template for Hysteria 2 links rendered through Xray.
  // The converter replaces the streamSettings placeholder below with a JSON
  // object. Naming it here as well would substitute it into this comment too;
  // harmless only as long as the object stays on one line.
  "remarks": "__REMARKS__",
  "outbounds": [
    {
      "protocol": "hysteria",
      "tag": "proxy",
      "settings": {
        "version": 2,
        "address": "__ADDRESS__",
        "port": "__PORT__"
      },
      "streamSettings": "__HY2_STREAM_SETTINGS__"
    },
    {
      "protocol": "freedom",
      "tag": "direct",
      "settings": {
        "domainStrategy": "AsIs"
      }
    },
    {
      "protocol": "blackhole",
      "tag": "block",
      "settings": {
        "response": {
          "type": "http"
        }
      }
    }
  ]
}
